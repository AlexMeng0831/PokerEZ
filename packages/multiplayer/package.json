{
  "name": "@pokerez/multiplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./dist/protocol.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
